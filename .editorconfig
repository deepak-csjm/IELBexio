root = true

[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
charset = utf-8

[*.cs]
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

# EF Core scaffolds migration files; they are generated code and are not hand-maintained,
# so analyzer style/perf rules are not enforced on them.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
