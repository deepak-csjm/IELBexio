# Copy to .env and fill in only what you need. Every value here is a placeholder.
#
# NEVER commit a filled-in .env. It is listed in .gitignore, and CI scans for committed secrets.
# The POC runs end to end with all of these left empty: Bexio, Shopify and Amazon default to
# mocks and fixtures, and AI is off.

# ---- Local infrastructure ----------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ielbexio
POSTGRES_PORT=5432
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# ---- Bexio -------------------------------------------------------------------------------------
# Mode: Mock (default, no Bexio account needed) or Api (live OAuth against Bexio).
# Register an application in the Bexio developer portal to obtain these; the redirect URI must
# match what the application sends.
BEXIO_MODE=Mock
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=

# ---- Shopify -----------------------------------------------------------------------------------
# Mode: Fixture (default, reads fixtures/shopify) or Live (Admin GraphQL API).
# The access token needs read_orders; read_customers is required for buyer details.
SHOPIFY_MODE=Fixture
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ---- Amazon Selling Partner API ------------------------------------------------------------------
# Mode: Fixture (default, reads fixtures/amazon) or Live.
# Buyer PII additionally requires an approved PII data-access role for the application.
AMAZON_MODE=Fixture
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_IDS=

# ---- Azure OpenAI --------------------------------------------------------------------------------
# Leave AI_ENABLED=false to run entirely deterministically. Prefer managed identity over a key:
# leave AZURE_OPENAI_API_KEY empty and the client uses DefaultAzureCredential.
AI_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ---- Azure (optional) ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Microsoft Entra ID ------------------------------------------------------------------------------
# Required before any non-development deployment: the application refuses to start with the
# development identity outside the Development environment.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
